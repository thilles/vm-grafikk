        <http://example.org/wc2026/resource/team/uzbekistan> ;
    foaf:name "2026 FIFA World Cup" .

ns1:calledUp a owl:ObjectProperty ;
    rdfs:label "calledUp"@en ;
    rdfs:comment "A player called up to this national team's squad."@en ;
    rdfs:domain ns1:NationalTeam ;
    rdfs:range ns1:Player ;
    owl:inverseOf ns1:playsForNationalTeam .

ns1:playsForNationalTeam a owl:ObjectProperty ;
    rdfs:label "playsForNationalTeam"@en ;
    rdfs:comment "The national team a player was called up to."@en ;
    rdfs:domain ns1:Player ;
    rdfs:range ns1:NationalTeam ;
    owl:inverseOf ns1:calledUp .

